// Claude in a box: open this workshop repository in VS Code, run "Dev Containers: Reopen in Container",
// then run `claude` in the container's terminal. Commands Claude runs stay in the container.
// Only for repositories you trust: https://code.claude.com/docs/en/devcontainer
{
  "name": "Mastering Claude Code",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "remoteUser": "node",
  "features": {
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
  },
  // optional token from `claude setup-token` in .devcontainer/.env (git-ignored);
  // the file is created empty on your machine if it is missing, so the container always starts
  "initializeCommand": ["node", "-e", "require('fs').appendFileSync('.devcontainer/.env', '')"],
  "runArgs": ["--env-file", "${localWorkspaceFolder}/.devcontainer/.env"],
  // keep the sign-in across rebuilds, one volume per repository
  "mounts": [
    "source=claude-code-config-${devcontainerId},target=/home/node/.claude,type=volume"
  ],
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/node/.claude",
    // the commands Claude runs don't see the token; Claude Code keeps it for its own calls
    "CLAUDE_CODE_SUBPROCESS_ENV_SCRUB": "1"
  },
  // the Bash sandbox needs bubblewrap and socat on Linux (docs: sandboxing)
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y bubblewrap socat",
  // the named volume is created root-owned; hand it to node so the sign-in can be saved.
  // The managed settings turn the sandbox on in strict mode (no retry outside it) and deny
  // reading secrets: they apply to every session in the container, above every other settings
  // file, and never touch this workshop repository's own .claude/settings.json
  "postStartCommand": "sudo chown -R node:node /home/node/.claude && sudo mkdir -p /etc/claude-code && sudo cp .devcontainer/managed-settings.json /etc/claude-code/managed-settings.json"
}
